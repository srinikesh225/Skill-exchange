# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
# Default: local SQLite file. Swap to PostgreSQL by setting a full URL, e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/skillpulse
DATABASE_URL=sqlite:///./skillpulse.db

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of origins allowed to call the API (browser cross-origin).
# Development: the frontend dev server. Production: add your deployed frontend
# domain, e.g. https://skill-exchange.vercel.app
# (Not needed when the frontend proxies /api/* server-to-server via next.config.)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Example for production:
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- Demo data generation ---
# Fixed seed keeps the synthetic dataset reproducible and internally consistent.
DEMO_SEED=20260930
DEMO_NUM_DISTRICTS=110
DEMO_JOBS_PER_DISTRICT=110

# --- Optional LLM enhancement layer (provider-agnostic; unused by default) ---
# The core engines do NOT require any LLM. This only enables an optional
# validation pass on extracted skills. Leave blank to disable.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
