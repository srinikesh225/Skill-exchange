# Never copy the host's (Windows) node_modules or build output into the Linux
# image — deps are installed fresh in the deps stage. Copying them clobbers the
# Linux binaries with Windows .bin shims and breaks `next build` (exit 127).
node_modules
.next
out
# Exclude ALL env files — `next build` reads .env, .env.production and
# .env.local, and none of them belong baked into an image layer.
.env
.env.*
*.tsbuildinfo
npm-debug.log*
test-results
playwright-report
